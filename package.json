{
  "name": "tilemap-parser",
  "version": "0.1.1",
  "description": "TypeScript port of tilemap-parser core (Phaser-targeted library). Engine-agnostic core plus thin Phaser bindings.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./phaser": {
      "types": "./dist/phaser/index.d.ts",
      "default": "./dist/phaser/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "phaser": ">=3.60.0"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "phaser": "3.90.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "FluffyBrudy <fluffyrudy@proton.me>",
  "keywords": [
    "tilemap",
    "phaser",
    "game",
    "parser",
    "collision",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FluffyBrudy/tilemap-parser-ts.git"
  },
  "homepage": "https://github.com/FluffyBrudy/tilemap-parser-ts#readme",
  "bugs": {
    "url": "https://github.com/FluffyBrudy/tilemap-parser-ts/issues"
  }
}
